{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TrialConfig",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "1.0.0"
    },
    "corpus": {
      "type": "string"
    },
    "participants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "api_dialect":{"enum":["chat_completions","chat_completions_reasoning"]},
          "reasoning_effort":{"enum":["none","low","medium","high"]},
          "contract_version": {
            "const": "1.0.0"
          },
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "kind": {
            "enum": [
              "recorded",
              "openai",
              "process",
              "mirai"
            ]
          },
          "model": {
            "type": [
              "string",
              "null"
            ]
          },
          "endpoint": {
            "type": "string"
          },
          "key_env": {
            "type": "string"
          },
          "command": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "module": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "commit": {
            "type": "string"
          },
          "memory": {
            "type": "boolean"
          }
        },
        "required": [
          "contract_version",
          "id",
          "kind",
          "model",
          "commit",
          "memory"
        ]
      }
    },
    "track": {
      "enum": [
        "execution",
        "text_to_outcome",
        "memory_change"
      ]
    },
    "mode": {
      "enum": [
        "system_bundle",
        "matched_tools"
      ]
    },
    "repeats": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "lengths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          10,
          100,
          1000
        ]
      }
    },
    "seeds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{1,64}$"
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "calls": {
          "type": "integer",
          "minimum": 1
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "deadline_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600000
        },
        "input_per_million": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "output_per_million": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "unknown_call_ceiling_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "calls",
        "input_tokens",
        "output_tokens",
        "cost_usd",
        "deadline_ms",
        "input_per_million",
        "output_per_million",
        "unknown_call_ceiling_usd"
      ]
    },
    "live": {
      "type": "boolean"
    },
    "permitted_data": {
      "const": "synthetic-only"
    },
    "routing": {
      "const": "fixed"
    },
    "sandbox_image": {
      "type": "string"
    }
  },
  "required": [
    "contract_version",
    "corpus",
    "participants",
    "track",
    "mode",
    "repeats",
    "lengths",
    "seeds",
    "budget",
    "live",
    "permitted_data",
    "routing"
  ]
}
