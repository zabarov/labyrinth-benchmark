{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UsageReceipt",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "calls": {
      "type": "integer",
      "minimum": 0
    },
    "input_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "output_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "cost_usd": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "provider_version": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "calls",
    "input_tokens",
    "output_tokens",
    "cost_usd",
    "provider_version"
  ]
}
