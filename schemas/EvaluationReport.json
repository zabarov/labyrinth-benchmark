{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EvaluationReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "benchmark_version",
    "config_digest",
    "corpus_digest",
    "evidence_kind",
    "review",
    "isolation",
    "totals",
    "usage",
    "rows",
    "groups",
    "limitations",
    "digest",
    "phase_usage"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0.0"
    },
    "benchmark_version": {
      "const": "0.1.0"
    },
    "config_digest": {
      "type": "string"
    },
    "corpus_digest": {
      "type": "string"
    },
    "digest": {
      "type": "string"
    },
    "evidence_kind": {
      "enum": [
        "recorded_harness",
        "execution_harness",
        "live_model",
        "mixed"
      ]
    },
    "review": {
      "const": "author_reported"
    },
    "isolation": {
      "const": "trusted_local"
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assigned",
        "exact",
        "false_completion",
        "unauthorized_disclosure"
      ],
      "properties": {
        "assigned": {
          "type": "integer",
          "minimum": 0
        },
        "exact": {
          "type": "integer",
          "minimum": 0
        },
        "false_completion": {
          "type": "integer",
          "minimum": 0
        },
        "unauthorized_disclosure": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calls",
        "input_tokens",
        "output_tokens",
        "cost_usd"
      ],
      "properties": {
        "calls": {
          "type": "integer",
          "minimum": 0
        },
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cost_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "group",
          "participant",
          "length",
          "phase",
          "status",
          "elapsed_ms",
          "exact_outcome",
          "correct_transitions",
          "required_transitions",
          "first_wrong_transition",
          "false_completion",
          "unauthorized_disclosure",
          "malformed",
          "oracle_digest"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "group": {
            "type": "string"
          },
          "participant": {
            "type": "string"
          },
          "length": {
            "enum": [
              10,
              100,
              1000
            ]
          },
          "phase": {
            "enum": [
              "cold",
              "unchanged",
              "source_edit",
              "goal_change",
              "new_scope",
              "revoked_access"
            ]
          },
          "status": {
            "enum": [
              "assigned",
              "running",
              "completed",
              "failed",
              "uncertain",
              "blocked"
            ]
          },
          "elapsed_ms": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "exact_outcome": {
            "type": "boolean"
          },
          "correct_transitions": {
            "type": "integer",
            "minimum": 0
          },
          "required_transitions": {
            "type": "integer",
            "minimum": 0
          },
          "first_wrong_transition": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "false_completion": {
            "type": "boolean"
          },
          "unauthorized_disclosure": {
            "type": "boolean"
          },
          "malformed": {
            "type": "boolean"
          },
          "oracle_digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "group",
          "preparation_ms",
          "total_ms",
          "cold_plus_unchanged_ms",
          "cold_plus_unchanged_cost_usd"
        ],
        "properties": {
          "cold_plus_unchanged_cost_usd": {"type":["number","null"],"minimum":0},
          "group": {
            "type": "string"
          },
          "preparation_ms": {
            "type": "number",
            "minimum": 0
          },
          "total_ms": {
            "type": "number",
            "minimum": 0
          },
          "cold_plus_unchanged_ms": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "phase_usage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "trial_id",
          "phase",
          "calls",
          "input_tokens",
          "output_tokens",
          "cost_usd"
        ],
        "properties": {
          "trial_id": {
            "type": "string"
          },
          "phase": {
            "type": "string"
          },
          "calls": {
            "type": "integer",
            "minimum": 0
          },
          "input_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "output_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "cost_usd": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
